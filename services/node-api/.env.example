PORT=4000
NODE_ENV=development

# Allow Flutter web (dynamic localhost ports) and Next.js dev clients.
# For strict production, set this to your real frontend URL.
CLIENT_ORIGIN=http://localhost:3000

# Optional: enable LLM-powered extraction/analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
LLM_TIMEOUT_MS=20000
